        "jsCode": "const expectedFiles = 3;\nconst items = $input.all();\nif (items.length !== expectedFiles) throw new Error('Entrega incompleta de áudios: esperados 3 arquivos, recebidos ' + items.length);\nconst out = { json: { ...items[0].json, totalBytes: 0 }, binary: {}, pairedItem: { item: 0 } };\nfor (let index = 0; index < items.length; index++) {\n  const item = items[index];\n  if (!item.binary?.data) throw new Error('Áudio não baixado: ' + String(item.json.filename || 'desconhecido'));\n  const key = 'audio' + String(index + 1).padStart(2, '0');\n  const filename = String(item.json.filename || item.binary.data.fileName || key + '.mp3');\n  out.binary[key] = { ...item.binary.data, fileName: filename, mimeType: 'audio/mpeg' };\n  out.json.totalBytes += Number(item.binary.data.bytes || 0);\n}\nout.json.attachments = Object.keys(out.binary).join(',');\nout.json.file_count = Object.keys(out.binary).length;\nreturn [out];"
