{
  "name": "[LAB] Copys - Analisar vídeo e oferta",
  "active": false,
  "description": "Analisa automaticamente uma nova transcrição da oferta e as copys campeãs, sem dados pessoais e sem envio.",
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true,
    "timezone": "America/Sao_Paulo",
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "nodes": [
    {
      "name": "Analisar agora",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -900,
        80
      ],
      "parameters": {}
    },
    {
      "name": "Buscar transcrição ativa",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        -620,
        180
      ],
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "copy_laboratory_assets",
        "returnAll": true,
        "orderBy": "updated_at.desc",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "asset_type",
              "condition": "eq",
              "keyValue": "video_transcript"
            },
            {
              "keyName": "is_active",
              "condition": "eq",
              "keyValue": "={{ true }}"
            }
          ]
        }
      }
    },
    {
      "name": "Buscar copys campeãs",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        -340,
        180
      ],
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "copy_variants",
        "returnAll": true,
        "orderBy": "recovery_flow.asc,step.asc",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "role",
              "condition": "eq",
              "keyValue": "champion"
            }
          ]
        }
      },
      "executeOnce": true
    },
    {
      "name": "Buscar regras da oferta",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        -60,
        180
      ],
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "copy_laboratory_assets",
        "returnAll": true,
        "orderBy": "updated_at.desc",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "is_active",
              "condition": "eq",
              "keyValue": "={{ true }}"
            }
          ]
        }
      },
      "executeOnce": true
    },
    {
      "name": "Verificar análise existente",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        220,
        180
      ],
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "copy_laboratory_assets",
        "returnAll": true,
        "orderBy": "created_at.desc",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "asset_type",
              "condition": "eq",
              "keyValue": "research_note"
            }
          ]
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "name": "Preparar análise sem PII",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const videos = $('Buscar transcrição ativa').all().map((item) => item.json).sort((a, b) => new Date(b.updated_at) - new Date(a.updated_at));\nconst video = videos[0];\nif (!video?.id || !String(video.content || '').trim()) return [];\nconst alreadyAnalyzed = $('Verificar análise existente').all().some((item) =>\n  String(item.json.source_asset_id || '') === String(video.id) &&\n  new Date(item.json.source_updated_at).toISOString() === new Date(video.updated_at).toISOString()\n);\nif (alreadyAnalyzed) return [];\nconst copies = $('Buscar copys campeãs').all().map((item) => ({\n  plataforma: item.json.platform || 'hotmart',\n  fluxo: item.json.recovery_flow,\n  etapa: item.json.step,\n  assunto: item.json.subject,\n  preheader: item.json.preheader,\n  corpo: item.json.body,\n  botao: item.json.button_text,\n  oferta: item.json.offer_code || null,\n  preco: item.json.displayed_price || null,\n}));\nconst rules = $('Buscar regras da oferta').all()\n  .filter((item) => ['offer_rules', 'brand_rules'].includes(String(item.json.asset_type || '')))\n  .map((item) => ({ titulo: item.json.title, conteudo: item.json.content }));\nconst prompt = [\n  'Analise a transcrição da oferta e as copys campeãs atuais de Hotmart e PerfectPay.',\n  'Compare cada plataforma separadamente; não misture preços, cupons nem checkouts.',\n  'Extraia somente elementos sustentados pelo material. Não invente promessas.',\n  'Nunca use dados pessoais; o material recebido é institucional.',\n  'Entregue insights, desejos, objeções, provas disponíveis, claims permitidas, claims proibidas, tom, hooks e resumo.',\n  'Aponte repetições e oportunidades específicas para os e-mails 2 e 3.',\n  '',\n  'TRANSCRIÇÃO:', String(video.content).slice(0, 60000),\n  '',\n  'REGRAS:', JSON.stringify(rules),\n  '',\n  'COPYS ATUAIS POR PLATAFORMA:', JSON.stringify(copies),\n].join('\\n');\nreturn [{ json: { source_asset_id: video.id, source_updated_at: video.updated_at, source_url: video.source_url || null, source_title: video.title, prompt } }];"
      }
    },
    {
      "name": "Analisar oferta e copys",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        780,
        180
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.prompt }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "Você é um estrategista de copy responsável. Diferencie fatos do material e inferências. Não invente evidências.",
          "maxIterations": 2
        },
        "enableStreaming": false
      }
    },
    {
      "name": "OpenAI econômico",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        640,
        500
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "GPT-5 mini"
        },
        "responsesApiEnabled": true,
        "options": {
          "reasoningEffort": "medium",
          "maxRetries": 2,
          "timeout": 90000
        }
      }
    },
    {
      "name": "Formato da análise",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        780,
        500
      ],
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\"summary\":\"Resumo objetivo da oferta\",\"desires\":[\"Desejo 1\"],\"objections\":[\"Objeção 1\"],\"available_proof\":[\"Prova realmente presente\"],\"allowed_claims\":[\"Claim permitida\"],\"prohibited_claims\":[\"Claim proibida\"],\"tone\":[\"Característica do tom\"],\"hooks\":[\"Gancho testável\"],\"email_2_opportunities\":[\"Oportunidade\"],\"email_3_opportunities\":[\"Oportunidade\"],\"repetitions_to_avoid\":[\"Repetição\"]}"
      }
    },
    {
      "name": "Preparar nota de pesquisa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const context = $('Preparar análise sem PII').first().json;\nconst analysis = $input.first().json.output || {};\nreturn [{ json: {\n  asset_type: 'research_note',\n  title: 'Análise automática — ' + String(context.source_title || 'vídeo principal'),\n  content: JSON.stringify(analysis),\n  source_url: context.source_url,\n  is_active: true,\n  source_asset_id: context.source_asset_id,\n  source_updated_at: context.source_updated_at,\n  metadata: { model: 'gpt-5-mini', pii_used: false, generated_at: new Date().toISOString() },\n} }];"
      }
    },
    {
      "name": "Salvar aprendizado",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1340,
        180
      ],
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "copy_laboratory_assets",
        "dataToSend": "autoMapInputData"
      }
    },
    {
      "name": "Verificar vídeo todos os dias",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        -900,
        280
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 7,
              "triggerAtMinute": 30
            }
          ]
        },
        "misfirePolicy": "skip"
      }
    },
    {
      "name": "Sticky Note a5e3bf5e",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
