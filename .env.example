# Supabase Auth (pode aparecer no navegador)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx

# SOMENTE NO SERVIDOR. NUNCA use NEXT_PUBLIC_ nesta variável.
SUPABASE_SERVICE_ROLE_KEY=COLE_A_SERVICE_ROLE_AQUI

# E-mails autorizados a entrar no dashboard, separados por vírgula.
# Ex.: voce@exemplo.com,outro@exemplo.com
DASHBOARD_ALLOWED_EMAILS=voce@exemplo.com,operacao@exemplo.com

# Fuso usado nos gráficos por dia
APP_TIMEZONE=America/Sao_Paulo

# n8n / webhooks (configure apenas no ambiente privado do n8n)
HOTMART_HOTTOK=SUBSTITUA_PELO_TOKEN_PRIVADO
PERFECTPAY_WEBHOOK_TOKEN=SUBSTITUA_PELO_TOKEN_PRIVADO

# URLs públicas criadas depois que os workflows forem importados.
# Nunca coloque URLs reais de produção no repositório público.
HOTMART_WEBHOOK_URL=https://example.invalid/webhook/hotmart
PERFECTPAY_WEBHOOK_URL=https://example.invalid/webhook/perfectpay
